	num-cs = <1>;

	flash10: flash@10 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;
	};
};

